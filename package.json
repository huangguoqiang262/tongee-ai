{
  "name": "tongee-ai",
  "version": "1.3.2",
  "description": "糖源AI，改变你的生活",
  "main": "./out/main/index.js",
  "author": "糖源AI，改变你的生活",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "start": "electron-vite preview",
    "dev": "electron-vite dev --mode development",
    "build": "electron-vite build --mode production",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:all": "npm run build && electron-builder --win --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "build-icon": "electron-icon-builder --input=./build/icon.png --output=build --flatten"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@element-plus/icons-vue": "^2.3.2",
    "@kangc/v-md-editor": "^2.3.18",
    "@onlyoffice/document-editor-vue": "^1.6.1",
    "@vue-office/docx": "^1.6.3",
    "@vue-office/excel": "^1.7.14",
    "@vue-office/pdf": "^2.0.10",
    "@vue-office/pptx": "^1.0.1",
    "@wangeditor/editor-for-vue": "^5.1.12",
    "axios": "^1.12.2",
    "electron-screenshots": "^0.5.27",
    "electron-updater": "^6.8.3",
    "element-plus": "^2.11.1",
    "html2canvas": "^1.4.1",
    "lodash.clonedeep": "^4.5.0",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "sse.js": "^2.7.2",
    "vue-router": "^4.5.1",
    "xgplayer": "^3.0.24"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^2.0.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.4.0",
    "electron-icon-builder": "^2.0.1",
    "electron-vite": "^4.0.0",
    "eslint": "^9.31.0",
    "eslint-plugin-vue": "^10.3.0",
    "prettier": "^3.6.2",
    "sass": "^1.92.0",
    "sass-loader": "^16.0.5",
    "unplugin-auto-import": "^20.1.0",
    "unplugin-vue-components": "^29.0.0",
    "vite": "^7.0.5",
    "vite-svg-loader": "^5.1.0",
    "vue": "^3.5.17",
    "vue-eslint-parser": "^10.2.0"
  }
}
